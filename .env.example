# Reaparr configuration. Copy to .env for local dev, or set as container env vars.

# --- Demo / first-run ---------------------------------------------------------
# 1 = boot fully populated with realistic fake data (no sources needed). See spec §12.2.
# Demo and real data live in SEPARATE db files, so demo mode can never touch real data:
#   REAPARR_DEMO=1  -> ./data/reaparr.db       (safe sandbox to iterate on)
#   REAPARR_DEMO=0  -> ./data-prod/reaparr.db  (your real, source-connected data)
REAPARR_DEMO=1

# --- Storage ------------------------------------------------------------------
# Volume-mounted directory holding the SQLite .db file (maps to /app/data in Docker).
# If unset, defaults to ./data in demo mode and ./data-prod in real mode.
# REAPARR_DATA_DIR=./data
# Optional explicit DB file path (overrides the mode-derived path above).
# REAPARR_DB_PATH=/app/data/reaparr.db

# --- Source connections (optional seeds) --------------------------------------
# The Settings UI is the source of truth at runtime; these only seed initial values.
# SONARR_URL=http://sonarr:8989
# SONARR_API_KEY=
# RADARR_URL=http://radarr:7878
# RADARR_API_KEY=
# SEERR_URL=http://seerr:5055
# SEERR_API_KEY=
# TAUTULLI_URL=http://tautulli:8181
# TAUTULLI_API_KEY=
